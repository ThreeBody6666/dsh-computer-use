{
  "name": "@crazy_th/dsh-computer-use",
  "version": "0.1.4",
  "description": "Native Windows Computer Use tools for DeepSeek Harness.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "src",
    "tests",
    "scripts/windows-driver.ps1",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "tsconfig.json",
    "tsconfig.validation.json",
    "tsup.config.ts"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm run build",
