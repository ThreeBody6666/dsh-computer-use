  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeBody6666/dsh-computer-use.git"
  },
  "bugs": {
    "url": "https://github.com/ThreeBody6666/dsh-computer-use/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6",
